{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["renovate"],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "enabled": true,
  "branchPrefix": "renovate/",
  "commitHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "auto",
  "timezone": "Europe/Paris",
  "semanticCommits": "enabled",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm"3",
    ":maintainLockFilesWeekly"
  ],
  "includePaths": [
    "020-hardware/mikrotik/**",
    "020-hardware/tplink/**",
    "030-software/fluxcd/apps/**",
    "030-software/fluxcd/requirements/**",
    "030-software/talos/**"
  ],
  "platformAutomerge": true,
  "flux": {
    "managerFilePatterns": [
      "030-software/fluxcd/{apps,requirements}/**/*.{yml,yaml}"
    ],
    "includePaths": [
      "030-software/fluxcd/apps/**",
      "030-software/fluxcd/requirements/**"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "030-software/fluxcd/{apps,requirements}/**/*.{yml,yaml}"
    ],
    "includePaths": [
      "030-software/fluxcd/apps/**",
      "030-software/fluxcd/requirements/**"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "030-software/fluxcd/{apps,requirements}/**/*.{yml,yaml}"
    ],
    "includePaths": [
      "030-software/fluxcd/apps/**",
      "030-software/fluxcd/requirements/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "030-software/fluxcd/{apps,requirements}/**/*.{yml,yaml}"
      ],
      "datasourceTemplate": "helm",
      "matchStrings": [
        "chart:\\s*(?<depName>[a-z0-9-]+)\\s*\\n\\s*version:\\s*\"?(?<currentValue>[\\w\\.\\*]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "030-software/fluxcd/{apps,requirements}/**/*.{yml,yaml}"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s]+)",
        "repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\"\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "lockFileMaintenance",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "patch",
        "minor",
        "major",
        "lockFileMaintenance"
      ],
      "dependencyDashboardApproval": false,
      "minimumReleaseAge": "3"
    },
    {
      "dependencyDashboardApproval": true,
      "matchUpdateTypes": ["minor", "major"]
    },
    {
      "matchDatasources": ["helm"],
      "commitMessageTopic": "Helm chart {{depName}}",
      "separateMinorPatch": true
    },
    {
      "matchDatasources": ["docker"],
      "commitMessageTopic": "Docker image {{depName}}",
      "commitMessageExtra": "to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "labels": ["image-release", "major"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "labels": ["image-release", "minor"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "labels": ["image-release", "patch"],
      "minimumReleaseAge": "3",
      "ignoreTests": true,
      "automerge": true
    },
    {
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["major"],
      "labels": ["helm-release", "major"],
      "automerge": false
    },
    {
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor"],
      "labels": ["helm-release", "minor"],
      "automerge": false
    },
    {
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["patch"],
      "labels": ["helm-release", "patch"],
      "minimumReleaseAge": "3",
      "ignoreTests": true,
      "automerge": true
    },
    {
      "matchUpdateTypes": ["patch"],
      "description": "Auto-merge patch updates",
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "3",
      "automerge": true,
      "ignoreTests": true,
      "addLabels": ["patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "description": "Minor updates require maintainer approval",
      "matchCurrentVersion": "!/^0/",
      "automerge": false,
      "addLabels": ["minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "description": "Major updates require maintainer approval",
      "automerge": false,
      "addLabels": ["major"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
