{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["renovate"],
  "enabled": true,
  "extends": ["config:recommended"],
  "includePaths": ["020-hardware/mikrotik/**", "020-hardware/tplink/**", "030-software/fluxcd/apps/**", "030-software/fluxcd/requirements/**", "030-software/talos/**"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "description": "Auto-merge patch updates",
      "automerge": true,
      "addLabels": ["auto-merge", "patch"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "description": "Minor updates require maintainer approval",
      "automerge": false,
      "addLabels": ["maintainer-review", "minor"]
    },
    {
      "matchUpdateTypes": ["major"],
      "description": "Major updates require maintainer approval",
      "automerge": false,
      "addLabels": ["maintainer-review", "major"]
    }
  ]
}
