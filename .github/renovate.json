{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardTitle": "Renovate Dashboard",
  "enabled": true,
  "commitHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "timezone": "Europe/Paris",
  "extends": ["github>home-operations/renovate-presets"],
  "includePaths": [
    "020-hardware/hanzo/**",
    "020-hardware/genji/**",
    "020-hardware/mikrotik/**",
    "020-hardware/roadhog/**",
    "020-hardware/tplink/**",
    "030-software/fluxcd/apps/**",
    "030-software/fluxcd/requirements/**",
    "030-software/talos/**"
  ],
  "packageRules": [
    {
      "automerge": true,
      "ignoreTests": true,
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "12 hours"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
