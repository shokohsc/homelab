{
  "policies": {
    "AppAutoUpdate": false,
    "BlockAboutAddons": false,
    "BlockAboutConfig": false,
    "BlockAboutProfiles": true,
    "BlockAboutSupport": true,
    "Bookmarks": [
      {
        "Title": "Ifconfig",
        "URL": "https://ifconfig.co/",
        "Favicon": "https://ifconfig.co/favicon.ico",
        "Folder": "Pages",
        "Placement": "toolbar"
      },
      {
        "Title": "DuckDuckGo",
        "URL": "https://duckduckgo.com/",
        "Favicon": "https://duckduckgo.com/favicon.ico",
        "Folder": "Pages",
        "Placement": "toolbar"
      },
      {
        "Title": "Whoogle",
        "URL": "http://whoogle.whoogle:5000/",
        "Favicon": "https://www.google.com/favicon.ico",
        "Folder": "Pages",
        "Placement": "toolbar"
      }
    ],
    "CaptivePortal": false,
    "DisableAppUpdate": true,
    "DisableBuiltinPDFViewer": true,
    "DisableDeveloperTools": false,
    "DisableFeedbackCommands": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxScreenshots": true,
    "DisableFirefoxStudies": true,
    "DisableForgetButton": true,
    "DisableMasterPasswordCreation": true,
    "DisablePocket": true,
    "DisablePrivateBrowsing": true,
    "DisableProfileImport": true,
    "DisableProfileRefresh": true,
    "DisableSafeMode": true,
    "DisableSetDesktopBackground": true,
    "DisableSystemAddonUpdate": true,
    "DisableTelemetry": true,
    "DisplayBookmarksToolbar": false,
    "DisplayMenuBar": true,
    "DnsOverHttps": {
      "Enabled":  true,
      "ProviderURL": "https://1.1.1.1/dns-query",
      "Locked": true,
      "ExcludedDomains": []
    },
    "DontCheckDefaultBrowser": true,
    "DownloadDirectory": "/downloads",
    "EnableTrackingProtection": {
      "Cryptomining": true,
      "Fingerprinting": true,
      "Value": true
    },
    "ExtensionSettings": {
      "*": {
        "installation_mode": "blocked"
      },
      "sponsorBlocker@ajay.app": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/sponsorblock/latest.xpi",
        "installation_mode": "force_installed"
      },
      "uBlock0@raymondhill.net": {
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
        "installation_mode": "force_installed"
      }
    },
    "ExtensionUpdate": false,
    "FirefoxHome": {
      "Search": false,
      "TopSites": false,
      "SponsoredTopSites": false,
      "Highlights": false,
      "Pocket": false,
      "SponsoredPocket": false,
      "Snippets": false,
      "Locked": true
    },
    "FlashPlugin": {},
    "HardwareAcceleration": false,
    "Homepage": {
      "URL": "https://ifconfig.co/",
      "Locked": true,
      "Additional": [],
      "StartPage": "homepage"
    },
    "NewTabPage": false,
    "NoDefaultBookmarks": true,
    "OfferToSaveLogins": false,
    "OfferToSaveLoginsDefault": false,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "PasswordManagerEnabled": false,
    "Permissions": {
      "Camera": {
        "BlockNewRequests": true
      },
      "Location": {
        "BlockNewRequests": true
      },
      "Microphone": {
        "BlockNewRequests": true
      },
      "Notifications": {
        "BlockNewRequests": true
      }
    },
    "PictureInPicture": {
      "Enabled": false,
      "Locked": false
    },
    "Preferences": {
      "browser.aboutConfig.showWarning": false,
      "browser.policies.runonce.setDefaultSearchEngine": false,
      "browser.tabs.warnOnClose": false,
      "browser.urlbar.suggest.bookmark": false,
      "browser.urlbar.suggest.history": false,
      "browser.urlbar.suggest.openpage": false,
      "datareporting.policy.dataSubmissionPolicyBypassNotification": true,
      "dom.disable_window_flip": true,
      "dom.disable_window_move_resize": true,
      "dom.event.contextmenu.enabled": true,
      "extensions.getAddons.showPane": false,
      "places.history.enabled": false,
      "privacy.file_unique_origin": true,
      "ui.key.menuAccessKeyFocuses": false,
      "network.trr.mode": 2,
      "network.trr.uri": "https://1.1.1.1/dns-query"
    },
    "PromptForDownloadLocation": false,
    "SanitizeOnShutdown": {
      "Cache": true,
      "Cookies": true,
      "Downloads": true,
      "FormData": true,
      "History": true,
      "OfflineApps": true,
      "Sessions": true,
      "SiteSettings": true
    },
    "SearchEngines": {
      "Add": [
        {
          "Name": "Whoogle",
          "URLTemplate": "http://whoogle.whoogle:5000/search?q={searchTerms}",
          "Method": "POST",
          "IconURL": "http://whoogle.whoogle:5000/favicon.ico",
          "Alias": "whoogle",
          "Description": "fuck google",
          "PostData": "q={searchTerms}"
        },
        {
          "Name": "Duckduckgo",
          "URLTemplate": "https://duckduckgo.com/?q={searchTerms}&ia=web",
          "Method": "POST",
          "IconURL": "https://duckduckgo.com/static-assets/favicons/favicon.ico",
          "Alias": "duckduckgo",
          "Description": "fuck google",
          "PostData": "q={searchTerms}"
        }
      ],
      "Default": "Duckduckgo",
      "PreventInstalls": true
    },
    "SearchSuggestEnabled": false,
    "ShowHomeButton": true
  }
}
